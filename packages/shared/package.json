{
  "name": "@cinescope/shared",
  "version": "1.0.0",
  "description": "Shared domain and application building blocks for cine-scope microservices",
  "private": true,
  "exports": {
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "default": "./dist/application/index.js"
    },
    "./infrastructure/http": {
      "types": "./dist/infrastructure/http/index.d.ts",
      "default": "./dist/infrastructure/http/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "express": "^4.19.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21"
  }
}
