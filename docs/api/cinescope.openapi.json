{
  "openapi": "3.0.3",
  "info": {
    "title": "cine-scope API (via gateway)",
    "version": "0.1.0",
    "description": "Every endpoint reachable through `gateway-service` as of the `gateway/proxy`\nbranch. The gateway strips its mount prefix before forwarding, so\n`/catalog/movies` arrives at catalog-service as `/movies`.\n\nServices that are still scaffolding (recommendation, review, watchlist)\nexpose only `/health`.\n\nEvery service mounts its routes at its own root, so the public prefix is\nalways the gateway's. Paths here are verified against the running stack.\n"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Gateway (docker compose)"
    }
  ],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "auth"
    },
    {
      "name": "movies"
    },
    {
      "name": "series"
    },
    {
      "name": "genres"
    },
    {
      "name": "companies"
    },
    {
      "name": "people"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Gateway liveness",
        "description": "Answered by the gateway itself, with no downstream call.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/auth/health": {
      "get": {
        "tags": ["health"],
        "summary": "auth-service liveness (proxied)",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/catalog/health": {
      "get": {
        "tags": ["health"],
        "summary": "catalog-service liveness (proxied)",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/recommendation/health": {
      "get": {
        "tags": ["health"],
        "summary": "recommendation-service liveness (proxied)",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/review/health": {
      "get": {
        "tags": ["health"],
        "summary": "review-service liveness (proxied)",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/watchlist/health": {
      "get": {
        "tags": ["health"],
        "summary": "watchlist-service liveness (proxied)",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Health"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "Register a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password", "name"],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "format": "password"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "example": {
                "username": "leo",
                "email": "leo@example.com",
                "password": "sup3r-secret-pw",
                "name": "Leo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Exchange credentials for a token pair",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "format": "password"
                  }
                }
              },
              "example": {
                "email": "leo@example.com",
                "password": "sup3r-secret-pw"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/TokenPair"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "Rotate a refresh token into a new pair",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/TokenPair"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Revoke a refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/catalog/movies": {
      "get": {
        "tags": ["movies"],
        "summary": "List movies",
        "description": "Public. Pagination defaults and clamping live in normalizePagination.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of movies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Movie"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "post": {
        "tags": ["movies"],
        "summary": "Create a movie",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CreatedId"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/catalog/movies/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": ["movies"],
        "summary": "Get a movie",
        "responses": {
          "200": {
            "description": "The movie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": ["movies"],
        "summary": "Replace a movie",
        "description": "Full replace — the body is the same shape as create.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/CreatedId"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["movies"],
        "summary": "Delete a movie",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/catalog/series": {
      "post": {
        "tags": ["series"],
        "summary": "Create a series",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeriesInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CreatedId"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/catalog/series/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": ["series"],
        "summary": "Get a series",
        "responses": {
          "200": {
            "description": "The series",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/catalog/genres": {
      "post": {
        "tags": ["genres"],
        "summary": "Create a genre",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "example": {
                "name": "Thriller"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CreatedId"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/catalog/genres/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": ["genres"],
        "summary": "Get a genre",
        "responses": {
          "200": {
            "description": "The genre",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/catalog/companies": {
      "post": {
        "tags": ["companies"],
        "summary": "Create a production company",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "logoPath": {
                    "type": "string",
                    "nullable": true
                  },
                  "countryCode": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2",
                    "nullable": true
                  }
                }
              },
              "example": {
                "name": "A24",
                "logoPath": null,
                "countryCode": "US"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CreatedId"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/catalog/companies/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": ["companies"],
        "summary": "Get a company",
        "responses": {
          "200": {
            "description": "The company",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "logoPath": {
                      "type": "string",
                      "nullable": true
                    },
                    "countryCode": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/catalog/people": {
      "post": {
        "tags": ["people"],
        "summary": "Create a person",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "biography": {
                    "type": "string",
                    "nullable": true
                  },
                  "birthDate": {
                    "type": "string",
                    "format": "date",
                    "nullable": true
                  },
                  "profilePath": {
                    "type": "string",
                    "nullable": true
                  }
                }
              },
              "example": {
                "name": "Michael Mann",
                "biography": null,
                "birthDate": "1943-02-05",
                "profilePath": null
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CreatedId"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/catalog/people/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": ["people"],
        "summary": "Get a person",
        "responses": {
          "200": {
            "description": "The person",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "biography": {
                      "type": "string",
                      "nullable": true
                    },
                    "birthDate": {
                      "type": "string",
                      "format": "date",
                      "nullable": true
                    },
                    "profilePath": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token from `/auth/login`. Catalog writes additionally\nrequire the `catalog:write` permission; without it the answer is 403.\n"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemas": {
      "RefreshTokenBody": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MovieInput": {
        "type": "object",
        "required": [
          "title",
          "overview",
          "releaseDate",
          "duration",
          "originalLanguage",
          "posterPath",
          "backdropPath",
          "genreIds",
          "castIds",
          "directorIds",
          "companyIds"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "overview": {
            "type": "string",
            "nullable": true
          },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "duration": {
            "type": "integer",
            "description": "Minutes",
            "nullable": true
          },
          "originalLanguage": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 639-1"
          },
          "posterPath": {
            "type": "string",
            "nullable": true
          },
          "backdropPath": {
            "type": "string",
            "nullable": true
          },
          "genreIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "castIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "directorIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "companyIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "title": "Heat",
          "overview": "A crew of professional thieves and the detective tracking them.",
          "releaseDate": "1995-12-15",
          "duration": 170,
          "originalLanguage": "en",
          "posterPath": null,
          "backdropPath": null,
          "genreIds": [],
          "castIds": [],
          "directorIds": [],
          "companyIds": []
        }
      },
      "Movie": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/MovieInput"
          }
        ]
      },
      "SeriesInput": {
        "type": "object",
        "required": [
          "title",
          "overview",
          "firstAirDate",
          "lastAirDate",
          "originalLanguage",
          "posterPath",
          "backdropPath",
          "genreIds",
          "castIds",
          "directorIds",
          "companyIds"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "overview": {
            "type": "string",
            "nullable": true
          },
          "firstAirDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "lastAirDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "originalLanguage": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 639-1"
          },
          "posterPath": {
            "type": "string",
            "nullable": true
          },
          "backdropPath": {
            "type": "string",
            "nullable": true
          },
          "genreIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "castIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "directorIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "companyIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "title": "The Wire",
          "overview": "Baltimore, from every side at once.",
          "firstAirDate": "2002-06-02",
          "lastAirDate": "2008-03-09",
          "originalLanguage": "en",
          "posterPath": null,
          "backdropPath": null,
          "genreIds": [],
          "castIds": [],
          "directorIds": [],
          "companyIds": []
        }
      },
      "Series": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/SeriesInput"
          }
        ]
      }
    },
    "responses": {
      "Health": {
        "description": "Service is up",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["ok"]
                },
                "service": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TokenPair": {
        "description": "Access and refresh tokens",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "accessToken": {
                  "type": "string"
                },
                "refreshToken": {
                  "type": "string"
                }
              }
