NODE_ENV=development
PORT=4002
DATABASE_URL=postgresql://user:password@localhost:5432/catalog_db
# Must be byte-identical to auth-service's JWT_ACCESS_SECRET: auth-service signs
# the access tokens (HS256) and this service verifies them with the same key.
JWT_ACCESS_SECRET=min-16-char-secret
# Declared for docker-compose parity, unused yet
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
