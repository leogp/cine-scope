{
  "name": "gateway-service",
  "version": "1.0.0",
  "description": "API Gateway — routes external traffic to downstream services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "jest",
    "test:int": "REDIS_URL=redis://redis:6379/15 jest -c jest.int.config.js --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@cinescope/shared": "*",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^3.0.7",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21"
  }
}
