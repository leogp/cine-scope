NODE_ENV=development
PORT=4000
# Downstream targets; docker-compose overrides these with in-network hostnames.
AUTH_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
RECOMMENDATION_SERVICE_URL=http://localhost:4003
REVIEW_SERVICE_URL=http://localhost:4004
WATCHLIST_SERVICE_URL=http://localhost:4005
# Must be byte-identical to auth-service's JWT_ACCESS_SECRET: auth-service signs
# the access tokens (HS256) and the gateway verifies them with the same key.
JWT_ACCESS_SECRET=min-16-char-secret
# Optional — default: 30000
# PROXY_TIMEOUT_MS=30000
# Rate-limit counters and response cache; docker-compose overrides this with the in-network hostname.
REDIS_URL=redis://localhost:6379
# Optional — defaults: 200, 60000, 300, 900000, 10, 30000, 524288
# REDIS_COMMAND_TIMEOUT_MS=200
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_CREDENTIALS_WINDOW_MS=900000
# RATE_LIMIT_CREDENTIALS_MAX=10
# CACHE_TTL_MS=30000
# CACHE_MAX_ENTRY_BYTES=524288