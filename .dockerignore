# Build context is the repository root (npm workspaces).
# Keep it lean and never ship installed deps or build output into an image.
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
# Generated in the builder from the schema; a host copy would mask a missing step.
**/prisma/generated

.git
.gitignore
.dockerignore

# Env & secrets. The `**/` forms matter: a bare `.env` only matches at the
# context root, and every service keeps its secrets in apps/<service>/.env.
**/.env
**/.env.*
!**/.env.example

# Logs & coverage
*.log
npm-debug.log*
logs
coverage
**/coverage
.nyc_output

# Editor / tooling
.vscode
.idea
*.swp
*.swo

# Docs
README.md
